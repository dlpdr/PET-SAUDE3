SECRET_KEY=sua_secret_key_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# URL de conexão do PostgreSQL (fornecida pelo Neon / produção)
# Exemplo: postgresql://usuario:senha@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Alternativa para desenvolvimento local com PostgreSQL sem URL:
DB_NAME=pet_saude
DB_USER=pet_saude
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Armazenamento de imagens no Cloudinary (produção)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URLs do Frontend e CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seu-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=

# Configurações de e-mail (EMAIL_HOST vazio imprime no terminal em DEBUG=True)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PET Saude <noreply@seu-dominio.com.br>

# Headers de segurança / HTTPS
TRUST_PROXY_HTTPS=False
SECURE_SSL_REDIRECT=False
