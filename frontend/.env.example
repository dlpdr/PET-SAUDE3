# Server-side URL, including /api/. Configure in Vercel before deploying.
BACKEND_API_URL=http://127.0.0.1:8000/api/
NEXT_PUBLIC_CONTACT_EMAIL=
# Public frontend HTTPS origin for Open Graph images.
SITE_URL=http://localhost:3000
# Optional Google OAuth web client ID (must match GOOGLE_CLIENT_ID in backend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
